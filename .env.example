# Safe default: paper broker. The programmatic API has an additional order lock.
BROKER_ENV=PAPER_ALPACA
TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
BROKER_TIMEOUT_SECONDS=10
TRADE_DB_PATH=data/trading.sqlite3
TIMEFRAME_MINUTES=1
ORDER_QUANTITY=1

# Alpaca paper credentials
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# Angel One credentials (used only with BROKER_ENV=LIVE_ANGEL_ONE)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
ANGEL_EXCHANGE=NSE
ANGEL_SYMBOL_TOKEN=

# Groww Trading API token or API key/secret
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_EXCHANGE=NSE
GROWW_SEGMENT=CASH
GROWW_EXCHANGE_TOKEN=

# Optional machine-learning filters
ML_GATE_ENABLED=false
PPO_MODEL_PATH=models/ppo_trade_filter
FINBERT_ENABLED=true
FINBERT_LOCAL_ONLY=false
FINBERT_MODEL=ProsusAI/finbert
BEARISH_BUY_THRESHOLD=-0.5
NEWS_SOURCE=alpaca
NEWS_CACHE_SECONDS=300
NEWS_LOOKBACK_MINUTES=120
NEWS_HEADLINES_FILE=data/news_headlines.json
MODEL_TRAIN_DAY_UTC=6
MODEL_TRAIN_HOUR_UTC=2
MODEL_TRAIN_TIMESTEPS=50000
MODEL_TRAIN_TIMEOUT_SECONDS=21600
